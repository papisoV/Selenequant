# App
SELENE_ENV=development
SELENE_LOG_LEVEL=INFO

# Paths
SELENE_DATA_DIR=./data
SELENE_DB_PATH=./data/selenespace.db
SELENE_DUCKDB_PATH=./data/selenespace.duckdb
SELENE_LOG_DIR=./logs

# Local API
SELENE_API_HOST=127.0.0.1
SELENE_API_PORT=8088

# Exchange defaults
SELENE_DEFAULT_EXCHANGE=binance
SELENE_DEFAULT_SYMBOL=BTCUSDT
SELENE_DEFAULT_TIMEFRAME=1m

# Binance API credentials (stored securely; configure via `selenespace setup`)
SELENE_BINANCE_API_KEY=
SELENE_BINANCE_API_SECRET=
SELENE_BINANCE_TESTNET=false

# OKX API credentials
SELENE_OKX_API_KEY=
SELENE_OKX_API_SECRET=
SELENE_OKX_PASSPHRASE=
SELENE_OKX_DEMO=false

# Polymarket CLOB credentials
SELENE_POLYMARKET_API_KEY=
SELENE_POLYMARKET_API_SECRET=
SELENE_POLYMARKET_PASSPHRASE=
SELENE_POLYMARKET_WALLET_ADDRESS=

# Network proxy (required in mainland China — adjust port to match your proxy tool)
# Supports: socks5://host:port, http://host:port, https://host:port
# Leave empty if your network can reach Binance/OKX/Polymarket directly.
# Alternatively, set your system proxy to Global Mode and SeleneQuant will auto-detect it.
SELENE_PROXY_URL=

# Redis (shared K-line cache + WebSocket pub/sub for multi-worker)
SELENE_REDIS_URL=redis://localhost:6379/0

# WebSocket / market data
SELENE_WS_ENABLED=true
SELENE_L2_ENABLED=true
SELENE_MARKET_CACHE_SIZE=10000
SELENE_KLINE_INTERVALS=30m,1h
SELENE_DEFAULT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# LLM provider
SELENE_LLM_PROVIDER=openai_compatible
SELENE_LLM_BASE_URL=
SELENE_LLM_API_KEY=
SELENE_LLM_MODEL=
SELENE_LLM_TIMEOUT_SECONDS=120

# Safety defaults
SELENE_ENABLE_REAL_TRADING=false
SELENE_ENABLE_SHELL_TOOLS=false
SELENE_ENABLE_FILE_WRITE_TOOLS=false
SELENE_ENABLE_EXTERNAL_FETCH=false

# Merge-specific variables (see .env.paper for paper mode, .env.live.example for live mode)
# Network selector: mainnet | testnet (controls which API key set is loaded)
SELENE_USE_NETWORK=
# Execution mode: paper (default) | shadow (journal only) | live (real orders)
SELENE_EXECUTION_MODE=paper
# Futures whitelist gate: 0 = spot-only safety, 1 = futures whitelist (requires enableFutures=True)
SELENE_ENABLE_FUTURES=0
# Market type: spot | futures — required to construct BinanceFuturesTradingAdapter
SELENE_EXCHANGE_MARKET_TYPE=spot

# Encryption (required for production; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SELENE_ENCRYPTION_KEY=
SELENE_ENCRYPTION_SALT=

# Exchange WebSocket overrides (leave empty for default URLs)
SELENE_BINANCE_WS_URL=
SELENE_BINANCE_REST_URL=
SELENE_BINANCE_FUTURES_WS_URL=
SELENE_BINANCE_FUTURES_REST_URL=

# Backtest / paper trading
SELENE_PAPER_STARTING_BALANCE=10000
SELENE_BACKTEST_DEFAULT_CAPITAL=10000

# Feature flags
SELENE_ENABLE_AGENT_DRAFTING=true
SELENE_ENABLE_PAPER_TRADING=true
SELENE_ENABLE_BACKTEST=true

# Taiwan FinMind (台股研究数据; token 从 finmindtrade.com 申请, 绝不落盘/进 git)
FINMIND_TOKEN=

# news-ingest (binance-quant L3 吸收; SELENE_NI_ 前缀避免与 tg-ingest 的 SELENE_NEWS_* 撞名)
# 总开关: 设 true 时 local-api 启动挂 3 后台循环(collector/tagger/detector)
SELENE_NI_ENABLED=
# LLM 打标用 key (DeepSeek 等兼容 OpenAI 协议; 不设则 tagger 循环警告一次后空转)
SELENE_NI_LLM_API_KEY=
# HTTP 代理逃生口 (显式传参, 不污染全局 env; 默认空=直连)
SELENE_NI_HTTP_PROXY=
