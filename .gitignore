__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
_test_alpha.log
logs/
_temp/
.venv/
venv/
build/
dist/
.DS_Store
node_modules/

# Merge additions (Phase 0)
.env
.env.bak*
.env.bak.testnet
data/*.db
data/*.db-wal
data/*.db-shm
data/tuning_results/
data/stage_b/
data/chat_logs/
data/serenity/
data/
# Runtime ledger: today's token usage on *this* machine. Persisted so a restart
# cannot silently lift the ceiling, but never a versioned artifact.
data/llm_usage.json
.omc/
.pytest_temp/

# Strategy JSONs are versioned artifacts (provenance metadata, E2E deps)
!data/
!data/strategies/
!data/strategies/**

# Demo klines generated by scripts/generate_demo_data.py (bootstrap artifact).
# 不忽略会让新用户跑完 bootstrap 就看到一堆未跟踪文件。
demo/data/

# Local API data dir (runtime klines etc.)
services/local-api/data/

# tg-ingest runtime state (codename_map.json auto-created on import)
packages/tg-ingest/selene_space_tg_ingest/data/

# Keep env examples tracked
!.env.example
!.env.paper
!.env.live.example

# MCP client config (.mcp.json) — per-machine, points at a local backend port.
# Commit it and every worktree auto-mounts that port's server; keep it local.
# The snippet lives in docs/mcp-server.md instead.
.mcp.json

# Other project memory (not this replica)
.claude/projects/

# Codebase-memory MCP index (local AI tool memory, do not commit)
.codebase-memory/

# JS deps (installed at repo root)
node_modules/

# Local API runtime/test data (per-replica)
services/local-api/app/data/
services/local-api/tests/data/

# 实验/ 与 调查报告/ = 本地研究产物（内部，不入库；tracked 旧文件由 release 排除集处理）
实验/
调查报告/
# A-share akashare parquet cache (runtime, regenerated)
packages/ashare/data_cache/

# Frontend parallel worktrees (each fork is an independent working copy)
.worktrees/

# kf dev/API server logs (runtime, per-replica)
kf-dev-*.log
kf-api-*.log

# Per-replica scratch: probe scripts, render screenshots, lint dumps.
# Diagnostics only — never product source. Keep on disk for evidence.
.scratch/
.tmp-shot/
.lintbase/

# Chrome render-profile (headless verification scratch, ~97MB — never commit)
.chrome-render-profile/
# Local render-audit evidence screenshots (per-machine, regenerated)
.audit-backtests/
