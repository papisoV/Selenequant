# App
SELENE_ENV=development
SELENE_LOG_LEVEL=INFO

# Paths
SELENE_DATA_DIR=./data
SELENE_DB_PATH=./data/selenespace.db
SELENE_DUCKDB_PATH=./data/selenespace.duckdb
SELENE_LOG_DIR=./logs

# Local API
SELENE_API_HOST=127.0.0.1
SELENE_API_PORT=8088

# Exchange defaults
SELENE_DEFAULT_EXCHANGE=binance
SELENE_DEFAULT_SYMBOL=BTCUSDT
SELENE_DEFAULT_TIMEFRAME=1m

# Binance API credentials (stored securely; configure via `selenespace setup`)
# Note: main.py reads SELENE_EXCHANGE_API_KEY (not SELENE_BINANCE_API_KEY).
# 两套 key 并存：mainnet + testnet，通过 SELENE_USE_NETWORK 切换
# SELENE_USE_NETWORK=mainnet → 读 MAINNET 段；=testnet → 读 TESTNET 段
# 代码 fallback：若 SELENE_USE_NETWORK 未设，默认 mainnet
SELENE_USE_NETWORK=testnet

# === MAINNET (real money) ===
SELENE_EXCHANGE_API_KEY_MAINNET=YOUR_BINANCE_MAINNET_API_KEY
SELENE_EXCHANGE_API_SECRET_MAINNET=YOUR_BINANCE_MAINNET_API_SECRET

# === TESTNET (paper/sandbox) ===
# 用户填入 testnet key（从 https://testnet.binancefuture.com 申请）
SELENE_EXCHANGE_API_KEY_TESTNET=YOUR_BINANCE_TESTNET_API_KEY
SELENE_EXCHANGE_API_SECRET_TESTNET=YOUR_BINANCE_TESTNET_API_SECRET

# === Active config (代码根据 SELENE_USE_NETWORK 选上面两组之一) ===
# 留空 — 启动时由 main.py 装配代码动态填充
SELENE_EXCHANGE_API_KEY=
SELENE_EXCHANGE_API_SECRET=
SELENE_BINANCE_TESTNET=true
SELENE_EXCHANGE_TESTNET=true

# Futures market type (spot|futures) — required to construct BinanceFuturesTradingAdapter
# instead of BinanceTradingAdapter in main.py L842-862
SELENE_EXCHANGE_MARKET_TYPE=futures

# Futures live trading whitelist gate (Plan v5)
# 0 = spot-only safety gate (default — refuses API keys with enableFutures=True)
# 1 = futures whitelist gate (requires enableFutures=True AND all other dangerous
#     perms False: enableWithdrawals/enableMargin/enableVanillaOptions)
SELENE_ENABLE_FUTURES=1

# Execution mode: paper (default, no real orders) | shadow (journal only) | live (real orders)
# Required to trigger LiveEngine assembly + futures whitelist gate check in main.py
SELENE_EXECUTION_MODE=live

# OKX API credentials
SELENE_OKX_API_KEY=
SELENE_OKX_API_SECRET=
SELENE_OKX_PASSPHRASE=
SELENE_OKX_DEMO=false

# Polymarket CLOB credentials
SELENE_POLYMARKET_API_KEY=
SELENE_POLYMARKET_API_SECRET=
SELENE_POLYMARKET_PASSPHRASE=
SELENE_POLYMARKET_WALLET_ADDRESS=

# Network proxy (required in mainland China — adjust port to match your proxy tool)
# Supports: socks5://host:port, http://host:port, https://host:port
# Leave empty if your network can reach Binance/OKX/Polymarket directly.
# Alternatively, set your system proxy to Global Mode and SeleneQuant will auto-detect it.
SELENE_PROXY_URL=
NO_PROXY=

# Redis (shared K-line cache + WebSocket pub/sub for multi-worker)
SELENE_REDIS_URL=redis://localhost:6379/0

# WebSocket / market data
SELENE_WS_ENABLED=true
SELENE_L2_ENABLED=true
SELENE_MARKET_CACHE_SIZE=10000
SELENE_KLINE_INTERVALS=30m,1h
SELENE_DEFAULT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# LLM provider
SELENE_LLM_PROVIDER=openai_compatible
SELENE_LLM_BASE_URL=
SELENE_LLM_API_KEY=
SELENE_LLM_MODEL=claude-opus-4-5-20251101
SELENE_LLM_TIMEOUT_SECONDS=120

# Safety defaults
SELENE_ENABLE_REAL_TRADING=true
SELENE_ENABLE_SHELL_TOOLS=false
SELENE_ENABLE_FILE_WRITE_TOOLS=false
SELENE_ENABLE_EXTERNAL_FETCH=false

# Backtest / paper trading
SELENE_PAPER_STARTING_BALANCE=10000
SELENE_BACKTEST_DEFAULT_CAPITAL=10000

# Feature flags
SELENE_ENABLE_AGENT_DRAFTING=true
SELENE_ENABLE_PAPER_TRADING=true
SELENE_ENABLE_BACKTEST=true

# Taiwan FinMind (台股研究数据; token 从 finmindtrade.com 申请, 绝不落盘/进 git)
FINMIND_TOKEN=
